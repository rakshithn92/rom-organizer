<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / transfer rules for Android 12 (API 31) and newer (attribute
  android:dataExtractionRules).

  The app's SQLite databases hold the TheGamesDB API key in plaintext
  (rom_tags.db under getDatabasesPath()), so the whole database domain is
  excluded from both cloud backup and device-to-device migration. The API key
  and keystore stay device-local by design: re-enter the key after restoring on
  a new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
